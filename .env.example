# QuantumTrade 2030 Environment Configuration

# Database
POSTGRES_PASSWORD=your_secure_password_here
TIMESCALE_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://quantumtrade:password@localhost:5432/quantumtrade

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# JWT & Security
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRATION=24h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# API Keys - Exchange Integrations
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret

# Blockchain RPC URLs
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Market Data Providers
BLOOMBERG_API_KEY=your_bloomberg_api_key
REUTERS_API_KEY=your_reuters_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
COINGECKO_API_KEY=your_coingecko_api_key

# AI/ML Services
OPENAI_API_KEY=your_openai_api_key
HUGGINGFACE_TOKEN=your_huggingface_token
ANTHROPIC_API_KEY=your_anthropic_api_key

# Quantum Computing
IBM_QUANTUM_TOKEN=your_ibm_quantum_token
AWS_BRAKET_ACCESS_KEY=your_aws_access_key
AWS_BRAKET_SECRET_KEY=your_aws_secret_key
DWAVE_API_TOKEN=your_dwave_api_token

# Monitoring & Logging
SENTRY_DSN=your_sentry_dsn
DATADOG_API_KEY=your_datadog_api_key
GRAFANA_PASSWORD=admin

# Email & Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SENDGRID_API_KEY=your_sendgrid_api_key

# SMS & Push Notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
FIREBASE_SERVER_KEY=your_firebase_server_key

# KYC/AML Services
JUMIO_API_TOKEN=your_jumio_api_token
JUMIO_API_SECRET=your_jumio_api_secret
CHAINALYSIS_API_KEY=your_chainalysis_api_key
COMPLY_ADVANTAGE_API_KEY=your_comply_advantage_key

# Cloud Services
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
GCP_PROJECT_ID=your_gcp_project_id
GCP_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# CDN & Storage
CLOUDFLARE_API_TOKEN=your_cloudflare_token
CLOUDFLARE_ZONE_ID=your_zone_id
S3_BUCKET_NAME=quantumtrade-assets
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_QUANTUM_OPTIMIZATION=false
ENABLE_NEURAL_INTERFACE=false
ENABLE_VR_TRADING=false
ENABLE_SOCIAL_TRADING=true
ENABLE_COPY_TRADING=true
ENABLE_AI_AGENTS=true

# Environment
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Trading Configuration
MAX_POSITION_SIZE=1000000
MAX_LEVERAGE=10
DEFAULT_SLIPPAGE_TOLERANCE=0.5
ORDER_TIMEOUT_SECONDS=30
MAX_ORDERS_PER_SECOND=100

# Risk Management
MAX_DAILY_LOSS_PERCENT=5
MAX_PORTFOLIO_RISK=20
MARGIN_CALL_THRESHOLD=0.3
LIQUIDATION_THRESHOLD=0.2

# Compliance
ENABLE_GEO_BLOCKING=true
BLOCKED_COUNTRIES=KP,IR,SY
ENABLE_TRANSACTION_MONITORING=true
SUSPICIOUS_ACTIVITY_THRESHOLD=10000

# Backup & Recovery
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
ENABLE_POINT_IN_TIME_RECOVERY=true
